node_modules/
dist/

# 运行期数据：SQLite 库、WAL 日志、仓库快照，均不入版本控制
server/data/
*.db
*.db-shm
*.db-wal

# 环境变量（含 SOP_MASTER_KEY，绝不入仓）
.env
.env.*
!.env.example
.sop-master-key

.DS_Store
*.log

# 本地代理会话、临时脚本缓存及 Vite 运行时配置，不属于项目交付内容
.cache/
.claude/
.workbuddy/
web/vite.config.ts.timestamp-*.mjs

# 前端调试过程生成的临时脚本和截图
web/scripts/.*-tmp.*
web/scripts/shots/
