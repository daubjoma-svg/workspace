{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "sop-system 设计 Token — Blueprint Calm（蓝图冷静）设计语言 · DTCG 格式 · 前端 import 使用",
  "$meta": {
    "author": "颜好看 (UI/UX Designer)",
    "version": "1.1.0",
    "register": "Product（设计服务产品）",
    "language": "Blueprint Calm",
    "threeAxis": { "DESIGN_VARIANCE": 3, "MOTION_INTENSITY": 3, "VISUAL_DENSITY": 7 },
    "colorRules": {
      "R1": "语义色作【文字】一律用 --*-ink；基色 accent/success/warn/danger 只用于填充、圆点、边框、图标（非文本 ≥3:1）。",
      "R2": "--scrim 禁止由任何随模式翻转的 Token 派生。深色下派生自 brand-strong/fg 会得到与背景等亮的遮罩，分离度仅 1.0x:1。",
      "R3": "--meta 为非文本专用（图标/分隔/禁用态），禁止承载任何字号的正文。弱化文本一律用 --muted。",
      "R4": "深色浮层分离度不靠 scrim（物理上限 ~1.5:1），靠 surfaceOverlay 抬升 + 1px overlayRing 描边。",
      "R5": "填充块底色（warnBg）自身对 surface <3:1，必须补 1px 同族基色边框满足 WCAG 1.4.11。",
      "washPercent": 12,
      "inkFormula": "color-mix(in srgb, <base> 70%, <mode fg>) — 70% 为实测下限，80% 时深色 danger 仅 4.14:1"
    },
    "changelog": {
      "1.1.0": [
        "新增 accent/success/warn/danger 四族 -ink 与 -wash（统一 12%）— 裁决决策1，采纳缺陷、否决命名与配比",
        "新增 scrim（双态字面量，禁派生）与 surfaceOverlay（深色须抬至 surface-3）— 裁决决策3",
        "新增 overlayRing（深色 rgba(255,255,255,.24) 强制描边）— 审阅深色态时新发现",
        "修复 light.warnBgInk 3.81:1 未达 AA → #5C2E00 (5.30:1) — 前端本轮未发现",
        "修复 dark.warnBg 裕度仅 0.01 → #A34A08 (5.33:1) — 前端本轮未发现",
        "修复 dark.meta 在 surface3 上 2.61:1 未达非文本 3:1 → #737F8D (最差 3.36:1) — 前端本轮未发现",
        "修复 light.scrim alpha 十六进制 0x80(0.502) → 0x8C(0.55)，与声明的 55% 对齐",
        "统一 dark.accentWash 8%(0x14) → 12%(0x1F)，与浅色对齐",
        "删除 info（青色，见 DESIGN.md §9.2 决策 2）— 改为单色序数梯 lv-1..4",
        "meta 角色由「弱化文本」降级为「非文本专用」"
      ]
    }
  },

  "base": {
    "font": {
      "display": {
        "$value": ["Geist", "Inter", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Display 字体：页面标题、统计大数字、Hero 数值。Geist 工程精度感 + 天然 tabular-nums"
      },
      "body": {
        "$value": ["Inter", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", "-apple-system", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Body 字体：正文/表格/表单/导航/按钮。开启 cv01 ss03 tnum 特征"
      },
      "cn": {
        "$value": ["Noto Sans SC", "PingFang SC", "Microsoft YaHei", "sans-serif"],
        "$type": "fontFamily",
        "$description": "中文回退栈（思源黑体），与 Inter/Geist 字重轴匹配"
      },
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
        "$type": "fontFamily",
        "$description": "等宽：单号/分支/commit/diff/时间戳/Token数/模型名。0/O、1/l 区分度高"
      }
    },
    "text": {
      "xs":  { "$value": "0.75rem",  "$type": "dimension", "$description": "12px 元数据/时间戳/徽章" },
      "sm":  { "$value": "0.8125rem","$type": "dimension", "$description": "13px 表格单元格/次级说明（密度7主力）" },
      "base":{ "$value": "0.875rem", "$type": "dimension", "$description": "14px 正文/表单/按钮" },
      "md":  { "$value": "1rem",     "$type": "dimension", "$description": "16px AI产物长文正文" },
      "lg":  { "$value": "1.125rem", "$type": "dimension", "$description": "18px 卡片标题/需求标题" },
      "xl":  { "$value": "1.25rem",  "$type": "dimension", "$description": "20px 区块标题" },
      "2xl": { "$value": "1.5rem",   "$type": "dimension", "$description": "24px 页面标题 H1" },
      "3xl": { "$value": "2rem",     "$type": "dimension", "$description": "32px 统计大数字（仅 Dashboard）" }
    },
    "leading": {
      "xs": { "$value": "1.5",   "$type": "number" },
      "sm": { "$value": "1.55",  "$type": "number" },
      "base":{ "$value": "1.6",  "$type": "number" },
      "md": { "$value": "1.7",   "$type": "number" },
      "lg": { "$value": "1.35",  "$type": "number" },
      "xl": { "$value": "1.25",  "$type": "number" },
      "2xl":{ "$value": "1.15",  "$type": "number" }
    },
    "weight": {
      "read":    { "$value": 400, "$type": "fontWeight", "$description": "正文/描述" },
      "emphasis":{ "$value": 510, "$type": "fontWeight", "$description": "表格表头/按钮/小标题（可变字体轴，中文回退500）" },
      "announce":{ "$value": 590, "$type": "fontWeight", "$description": "页面标题/强调（中文回退600）" }
    },
    "tracking": {
      "body":   { "$value": "0em",     "$type": "dimension", "$description": "正文 14-16px" },
      "small":  { "$value": "0.01em",  "$type": "dimension", "$description": "小字 12-13px" },
      "caps":   { "$value": "0.06em",  "$type": "dimension", "$description": "ALL CAPS 标签（表头/section标题）必加" },
      "heading":{ "$value": "-0.015em","$type": "dimension", "$description": "标题 ≥24px" },
      "display":{ "$value": "-0.025em","$type": "dimension", "$description": "展示数字 ≥32px" }
    },
    "radius": {
      "sm":   { "$value": "6px",    "$type": "dimension", "$description": "控件/徽章/输入框" },
      "md":   { "$value": "12px",   "$type": "dimension", "$description": "卡片/下拉/浮层" },
      "lg":   { "$value": "16px",   "$type": "dimension", "$description": "模态/大面" },
      "pill": { "$value": "9999px", "$type": "dimension", "$description": "pill 标签/按钮" }
    },
    "space": {
      "1":  { "$value": "4px",  "$type": "dimension" },
      "2":  { "$value": "8px",  "$type": "dimension" },
      "3":  { "$value": "12px", "$type": "dimension" },
      "4":  { "$value": "16px", "$type": "dimension" },
      "5":  { "$value": "20px", "$type": "dimension" },
      "6":  { "$value": "24px", "$type": "dimension" },
      "8":  { "$value": "32px", "$type": "dimension" },
      "10": { "$value": "40px", "$type": "dimension" },
      "12": { "$value": "48px", "$type": "dimension" },
      "16": { "$value": "64px", "$type": "dimension" }
    },
    "motion": {
      "instant": { "$value": "0ms",   "$type": "duration", "$description": "Tab切换/筛选/排序/视图切换 — 0ms 往往是最好的选择" },
      "fast":    { "$value": "120ms", "$type": "duration", "$description": "hover/focus/按钮态" },
      "base":    { "$value": "180ms", "$type": "duration", "$description": "下拉/Toast/行展开" },
      "slow":    { "$value": "240ms", "$type": "duration", "$description": "模态/抽屉" },
      "ease":    { "$value": [0.2, 0, 0, 1], "$type": "cubicBezier", "$description": "全局标准缓动" }
    },
    "shadow": {
      "flat": { "$value": "none", "$type": "shadow" },
      "ring": {
        "$value": "0 0 0 1px rgba(16, 23, 36, 0.10)",
        "$type": "shadow",
        "$description": "shadow-as-border 理念：用 1px 环代替实体边框，避免 box model 抖动（浅色值）"
      },
      "raised": {
        "$value": "0 1px 2px rgba(16, 23, 36, 0.05), 0 4px 14px rgba(16, 23, 36, 0.06)",
        "$type": "shadow",
        "$description": "卡片抬升（浅色值）；深色态在 CSS 中覆盖"
      },
      "overlay": {
        "$value": "0 4px 8px rgba(16, 23, 36, 0.06), 0 14px 34px rgba(16, 23, 36, 0.10)",
        "$type": "shadow",
        "$description": "模态/抽屉浮层（浅色值）"
      }
    }
  },

  "theme": {
    "light": {
      "$description": "浅色主题（默认）。冷调纸面，非奶油非米色。",
      "color": {
        "bg":            { "$value": "#F5F7FA", "$type": "color", "$role": "A1-identity" },
        "surface":       { "$value": "#FFFFFF", "$type": "color", "$role": "A1-identity" },
        "surface2":      { "$value": "#EEF2F6", "$type": "color", "$role": "B-slot", "$description": "表头/内嵌块/hover底" },
        "surfaceOverlay":{ "$value": "#FFFFFF", "$type": "color", "$role": "B-slot", "$description": "模态/下拉/popover 面色。浅色下与 surface 同值（抬升靠阴影）" },
        "fg":            { "$value": "#101724", "$type": "color", "$role": "A1-identity", "$description": "近黑带蓝铸调，非纯黑。17.95:1 on surface" },
        "fg2":           { "$value": "#3C4859", "$type": "color", "$role": "B-slot", "$description": "正文次级。9.28 surface / 8.65 bg / 8.25 surface2" },
        "muted":         { "$value": "#5D6B7E", "$type": "color", "$role": "A1-identity", "$description": "弱化文本安全线。5.43 surface / 5.06 bg / 4.82 surface2 — 全部 ≥4.5 ✓" },
        "meta":          { "$value": "#7A8798", "$type": "color", "$role": "B-slot", "$description": "【非文本专用】3.65 surface / 3.41 bg / 3.25 surface2 — 满足 1.4.11 的 3:1，但任何字号正文都不达 4.5。仅用于图标、分隔、禁用态（禁用态 WCAG 1.4.3 豁免）" },
        "border":        { "$value": "#E2E7EE", "$type": "color", "$role": "A1-identity" },
        "borderSoft":    { "$value": "#EFF2F6", "$type": "color", "$role": "B-slot" },
        "borderStrong":  { "$value": "#CBD3DE", "$type": "color", "$role": "B-slot" },
        "accent":        { "$value": "#0E62A8", "$type": "color", "$role": "A1-identity", "$description": "Cyanotype 工程蓝墨。6.30 surface / 5.87 bg / 5.60 surface2 ✓ 每屏≤2处" },
        "accentOn":      { "$value": "#FFFFFF", "$type": "color", "$role": "A2", "$description": "6.30:1 on accent ✓" },
        "accentHover":   { "$value": "#0D5897", "$type": "color", "$role": "A2", "$description": "accent 90% + 黑 10%" },
        "accentActive":  { "$value": "#0B508A", "$type": "color", "$role": "A2", "$description": "accent 82% + 黑 18%" },
        "accentWash":    { "$value": "#0E62A81F", "$type": "color", "$role": "A2", "$description": "accent 12% — 选中底/弱高亮/焦点环。v1.1.0 由 8%(0x14) 统一为 12%(0x1F)" },
        "accentInk":     { "$value": "#0F4C80", "$type": "color", "$role": "A2", "$description": "accentWash 底上的文字。7.46 on wash/surface，最差 6.20:1 ✓", "$extensions": { "formula": "color-mix(in srgb, var(--accent) 70%, var(--fg))" } },
        "success":       { "$value": "#12805C", "$type": "color", "$role": "A2-semantic", "$description": "深松绿，非 Tailwind green-600。4.92 surface / 4.58 bg / 4.37 surface2 — surface2 上已跌破 4.5，故【作文字必须改用 successInk】" },
        "successWash":   { "$value": "#12805C1F", "$type": "color", "$role": "A2-semantic", "$description": "success 12% 底" },
        "successInk":    { "$value": "#11604B", "$type": "color", "$role": "A2-semantic", "$description": "successWash 底上的文字。6.35 wash/surface · 5.94 wash/bg · 5.69 wash/surface2 ✓（原 success 直用仅 4.19:1 FAIL）", "$extensions": { "formula": "color-mix(in srgb, var(--success) 70%, var(--fg))" } },
        "warn":          { "$value": "#B45309", "$type": "color", "$role": "A2-semantic", "$description": "深琥珀。5.02 surface / 4.68 bg / 4.46 surface2 — 作文字必须改用 warnInk" },
        "warnWash":      { "$value": "#B453091F", "$type": "color", "$role": "A2-semantic", "$description": "warn 12% 底" },
        "warnInk":       { "$value": "#834111", "$type": "color", "$role": "A2-semantic", "$description": "warnWash 底上的文字。6.54 wash/surface · 6.12 wash/bg · 5.85 wash/surface2 ✓（原 warn 直用 4.26:1 FAIL — 前端本轮未发现）", "$extensions": { "formula": "color-mix(in srgb, var(--warn) 70%, var(--fg))" } },
        "warnBg":        { "$value": "#F59E0B", "$type": "color", "$role": "A2-semantic", "$description": "amber-500 仅作背景填充块（Mock 警示条），配 warnBgInk。自身 on surface 仅 2.15:1，故填充块必须additionally带 1px var(--warn) 边框以满足 1.4.11" },
        "warnBgInk":     { "$value": "#5C2E00", "$type": "color", "$role": "A2-semantic", "$description": "warnBg 上的文字 5.30:1 ✓。v1.1.0 修复：原 #7C3F00 仅 3.81:1 未达 AA" },
        "danger":        { "$value": "#B3261E", "$type": "color", "$role": "A2-semantic", "$description": "砖红。6.54 surface / 6.09 bg / 5.81 surface2" },
        "dangerWash":    { "$value": "#B3261E1F", "$type": "color", "$role": "A2-semantic", "$description": "danger 12% 底" },
        "dangerInk":     { "$value": "#822220", "$type": "color", "$role": "A2-semantic", "$description": "dangerWash 底上的文字。7.85 wash/surface · 7.34 wash/bg · 7.02 wash/surface2 ✓", "$extensions": { "formula": "color-mix(in srgb, var(--danger) 70%, var(--fg))" } },
        "scrim":         { "$value": "#1017248C", "$type": "color", "$role": "A2", "$description": "rgba(16,23,36,0.55) 字面量，禁止派生（见 R2）。遮后页面 L* 97.2→51.8（ΔL*=45.4）；浮层(#FFF)/遮后底 4.21:1 ✓ 满足 1.4.11；背景正文由 16.72:1 压到 4.27:1 视觉退居后景。0.45 时仅 3.12:1 裕度不足，故取 0.55" },
        "overlayRing":   { "$value": "#10172414", "$type": "color", "$role": "A2", "$description": "浮层描边 rgba(16,23,36,0.08)。浅色下浮层已靠自身 4.21:1 达标，此环仅作物理边缘；深色下为强制项（见 dark.overlayRing）" },
        "brand":         { "$value": "#1E3A5F", "$type": "color", "$role": "A1-identity", "$description": "品牌藏青：登录Hero/侧栏logo底。白字 11.50:1 ✓" },
        "brandStrong":   { "$value": "#16293F", "$type": "color", "$role": "B-slot", "$description": "白字 14.76:1 ✓。⚠ 不可用作 scrim 基色（见 R2）" },
        "aiSurface":     { "$value": "#F7F9FB", "$type": "color", "$role": "C-extension", "$description": "AI『机器纸』冷灰底，比bg更冷更淡" },
        "aiInk":         { "$value": "#3D4654", "$type": "color", "$role": "C-extension", "$description": "AI mono 标签色，石墨中性。9.03:1 on aiSurface ✓" },
        "aiDash":        { "$value": "#C3CCD8", "$type": "color", "$role": "C-extension", "$description": "AI 虚线边框色" }
      }
    },
    "dark": {
      "$description": "深色主题（对等，非反色）。亮度阶梯法建立层级，不用阴影。",
      "color": {
        "bg":            { "$value": "#0E1116", "$type": "color", "$role": "A1-identity" },
        "surface":       { "$value": "#151A21", "$type": "color", "$role": "A1-identity" },
        "surface2":      { "$value": "#1C222B", "$type": "color", "$role": "B-slot" },
        "surface3":      { "$value": "#262E39", "$type": "color", "$role": "B-slot", "$description": "hover/抬升" },
        "surfaceOverlay":{ "$value": "#262E39", "$type": "color", "$role": "B-slot", "$description": "模态/下拉/popover 面色 = surface-3。深色下浮层【必须】抬升到此值：停留在 surface 时与遮后页面仅 ΔL*=7.2、1.15:1，看不出浮层边界；抬到 surface-3 后 ΔL*=15.8" },
        "fg":            { "$value": "#E9EEF5", "$type": "color", "$role": "A1-identity", "$description": "16.22 bg / 14.99 surface / 13.72 surface2 / 11.76 surface3" },
        "fg2":           { "$value": "#C3CCD9", "$type": "color", "$role": "B-slot", "$description": "11.67 bg / 10.79 surface / 9.87 surface2 / 8.46 surface3" },
        "muted":         { "$value": "#8B97A6", "$type": "color", "$role": "A1-identity", "$description": "6.37 bg / 5.89 surface / 5.39 surface2 / 4.62 surface3 — surface3 上裕度仅 0.12，禁止再叠更亮的面" },
        "meta":          { "$value": "#737F8D", "$type": "color", "$role": "B-slot", "$description": "【非文本专用】4.64 bg / 4.29 surface / 3.92 surface2 / 3.36 surface3。v1.1.0 修复：原 #626D7B 在 surface3 上仅 2.61:1，连非文本 3:1 都不达" },
        "border":        { "$value": "rgba(255, 255, 255, 0.07)", "$type": "color", "$role": "A1-identity" },
        "borderSoft":    { "$value": "rgba(255, 255, 255, 0.04)", "$type": "color", "$role": "B-slot" },
        "borderStrong":  { "$value": "rgba(255, 255, 255, 0.12)", "$type": "color", "$role": "B-slot" },
        "accent":        { "$value": "#4FA6EE", "$type": "color", "$role": "A1-identity", "$description": "7.23 bg / 6.68 surface ✓ 每屏≤2处" },
        "accentOn":      { "$value": "#06121D", "$type": "color", "$role": "A2", "$description": "深色态主按钮反色字" },
        "accentHover":   { "$value": "#4795D6", "$type": "color", "$role": "A2" },
        "accentActive":  { "$value": "#4188C3", "$type": "color", "$role": "A2" },
        "accentWash":    { "$value": "#4FA6EE1F", "$type": "color", "$role": "A2", "$description": "accent 12%。v1.1.0 由 8%(0x14) 统一为 12%(0x1F)，与浅色对齐" },
        "accentInk":     { "$value": "#7DBCF0", "$type": "color", "$role": "A2", "$description": "accentWash 底上的文字。7.83 wash/bg · 7.09 wash/surface · 6.43 wash/surface2 · 5.51 wash/surface3 ✓", "$extensions": { "formula": "color-mix(in srgb, var(--accent) 70%, var(--fg))" } },
        "success":       { "$value": "#35B37E", "$type": "color", "$role": "A2-semantic", "$description": "6.58 surface — 作文字仍必须用 successInk（wash 底会拉低）" },
        "successWash":   { "$value": "#35B37E1F", "$type": "color", "$role": "A2-semantic", "$description": "success 12% 底" },
        "successInk":    { "$value": "#6BC5A2", "$type": "color", "$role": "A2-semantic", "$description": "7.72 wash/bg · 7.00 wash/surface · 6.35 wash/surface2 · 5.45 wash/surface3 ✓", "$extensions": { "formula": "color-mix(in srgb, var(--success) 70%, var(--fg))" } },
        "warn":          { "$value": "#D9973E", "$type": "color", "$role": "A2-semantic", "$description": "7.03 surface" },
        "warnWash":      { "$value": "#D9973E1F", "$type": "color", "$role": "A2-semantic", "$description": "warn 12% 底" },
        "warnInk":       { "$value": "#DEB175", "$type": "color", "$role": "A2-semantic", "$description": "8.08 wash/bg · 7.33 wash/surface · 6.65 wash/surface2 · 5.71 wash/surface3 ✓", "$extensions": { "formula": "color-mix(in srgb, var(--warn) 70%, var(--fg))" } },
        "warnBg":        { "$value": "#A34A08", "$type": "color", "$role": "A2-semantic", "$description": "深色态深琥珀填充底，配 warnBgInk 得 5.33:1 ✓。v1.1.0 修复：原 #B45309 配同字仅 4.51:1，裕度 0.01 形同不达标。自身 on surface 2.95:1 <3，填充块必须带 1px var(--warn) 边框满足 1.4.11" },
        "warnBgInk":     { "$value": "#FFF1DC", "$type": "color", "$role": "A2-semantic", "$description": "warnBg 上的文字 5.33:1 ✓" },
        "danger":        { "$value": "#E5645C", "$type": "color", "$role": "A2-semantic", "$description": "5.25 surface" },
        "dangerWash":    { "$value": "#E5645C1F", "$type": "color", "$role": "A2-semantic", "$description": "danger 12% 底" },
        "dangerInk":     { "$value": "#E68D8A", "$type": "color", "$role": "A2-semantic", "$description": "6.78 wash/bg · 6.19 wash/surface · 5.64 wash/surface2 · 4.85 wash/surface3 ✓ — 全族最差项，也是 ink 配比锁定 70%（而非前端提议的 80%）的原因：80% 时此项仅 4.14:1 FAIL", "$extensions": { "formula": "color-mix(in srgb, var(--danger) 70%, var(--fg))" } },
