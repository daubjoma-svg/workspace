# MySQL 8.0 connection. Never commit the real .env file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sop_system
DB_USER=sop_app
DB_PASSWORD=change_me
DB_POOL_SIZE=10

# Generate once and retain securely: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOP_MASTER_KEY=
PORT=4000

# 可选：Jira 默认项目 Key。产品未在 Jira 设置里填写默认项目时回退到该值，便于「只填地址/账号/Token」即可创建。
JIRA_DEFAULT_PROJECT_KEY=
