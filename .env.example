# Docker Compose 项目标识。修改后会改变数据卷名称，已有环境不要随意调整。
COMPOSE_PROJECT_NAME=sop-system
APP_IMAGE=sop-system:latest

# 默认只允许宿主机反向代理访问；内网直接访问时改为 0.0.0.0。
APP_BIND_IP=127.0.0.1
APP_PORT=4000
APP_BASE_URL=https://sop.example.com

# MySQL。两个密码必须使用随机强密码，不能保留为空。
DB_NAME=sop_system
DB_USER=sop_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_POOL_SIZE=10
DB_TIMEZONE=+00:00

# 32 字节 base64 或 64 位 hex。首次生成后必须长期保留，禁止在升级时重新生成。
SOP_MASTER_KEY=

LOG_LEVEL=info
TZ=Asia/Shanghai

# 可选：Jira 默认项目 Key。
JIRA_DEFAULT_PROJECT_KEY=

# 外部服务与仓库同步超时/限额。
MAX_ARCHIVE_MB=200
TAR_TIMEOUT_MS=120000
GITLAB_TIMEOUT_MS=30000
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=4096

